{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "googlehealth-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "GoogleHealthMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GoogleHealthMCP"] }],
  // Holds the Google login. No id needed: the first deploy creates the namespace in your
  // Cloudflare account and later deploys keep using it.
  "kv_namespaces": [{ "binding": "TOKENS" }],
  "vars": {
    // Optional https origin of the worker for login links. Leave empty to use the origin each
    // request arrives on.
    "PUBLIC_URL": "",
    // Space separated scope override; leave empty for the defaults in src/health.ts.
    // Example: "activity_and_fitness.readonly health_metrics_and_measurements.readonly sleep.readonly nutrition.readonly"
    "SCOPES": "",
    // IANA time zone (e.g. "Europe/Berlin") that decides what "today" means when the
    // settings.readonly permission was not granted; with it, your Google Health time zone is used.
    "DEFAULT_TIMEZONE": "UTC"
  }
}
