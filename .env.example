# Google OAuth 2.0 client for the Google Health API.
# Google Cloud console > APIs & Services > Credentials > Create credentials > OAuth client ID
# (type "Web application"). Copy this file to .env and fill in the two values; .env is
# git-ignored. `npm run setup` in worker/ uploads them to your worker as secrets.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
